# Copy to .env and fill in. .env is gitignored; this file is not.

# Where raw/interim/processed data lives. Leave unset to keep everything under the
# repository's own data/ directory. Set it to a path outside any cloud-synced folder
# when working with the full KKBox files (~4 GB) -- see src/mandateguard/data/paths.py.
#
# Set it for the SAMPLE chain too, if this checkout sits inside OneDrive/Dropbox/iCloud.
# Measured 2026-09-04: `mandateguard repro --check` took 2m51s with derived frames on a
# plain drive and 64m01s with them on a cloud-synced path. The output was byte-identical
# both times, so nothing failed -- the only symptom was an hour of waiting.
MANDATEGUARD_DATA_DIR=

# Used by the four bounded Claude jobs in src/mandateguard/agent/ (Phase 4).
ANTHROPIC_API_KEY=
