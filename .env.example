# Copy to .env and fill in. .env is gitignored; this file is not.

# Where raw/interim/processed data lives. Leave unset to keep everything under the
# repository's own data/ directory. Set it to a path outside any cloud-synced folder
# when working with the full KKBox files (~4 GB) -- see src/mandateguard/data/paths.py.
MANDATEGUARD_DATA_DIR=

# Used by the four bounded Claude jobs in src/mandateguard/agent/ (Phase 4).
ANTHROPIC_API_KEY=
